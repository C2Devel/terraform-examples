AT_BANNER([plan,apply,destroy,import aws_ec2_transit_gateway resource])

AT_SETUP([plan aws_ec2_transit_gateway])
AT_CHECK([make -C "$SRCDIR" plan-aws_ec2_transit_gateway],,[ignore],[ignore])
AT_CLEANUP

AT_SETUP([apply aws_ec2_transit_gateway])
AT_CHECK([make -C "$SRCDIR" apply-aws_ec2_transit_gateway],,[ignore],[ignore])
AT_CLEANUP

AT_SETUP([apply data-aws_ec2_transit_gateway])
AT_SKIP_IF([test ! -d "$SRCDIR"cases/data_aws_ec2_transit_gateway])
AT_CHECK([make -C "$SRCDIR" apply-data_aws_ec2_transit_gateway],,[ignore],[ignore])
AT_CLEANUP

AT_SETUP([destroy aws_ec2_transit_gateway])
AT_CHECK([make -C "$SRCDIR" destroy-aws_ec2_transit_gateway],,[ignore],[ignore])
AT_CLEANUP

AT_SETUP([import aws_ec2_transit_gateway])
AT_SKIP_IF([true])
AT_CLEANUP
